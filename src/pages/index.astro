---
import About from '../components/drawn/About';
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import PortraitOutline from '../components/drawn/PortraitOutline';
import DrawnRule from '../components/DrawnRule.astro';
import { profile, href } from '../config';
---
<Base>
  <section class="intro" aria-labelledby="intro-name">
    <div class="portrait-frame"><PortraitOutline client:load /><img class="portrait" src={href('images/cobuter-man.png')} alt="CobuterMan, a suited figure with a computer monitor for a head" width="550" height="512" fetchpriority="high" /></div>
    <h1 id="intro-name">{profile.name}</h1>
    <p>{profile.description}</p>
    <Contact compact />
  </section>
  <DrawnRule variant={0} />
  <section class="grid2 home-section" aria-labelledby="about-label">
    <div><h2 class="label" id="about-label">About</h2></div>
    <About client:load />
  </section>
</Base>
